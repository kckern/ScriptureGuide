<%- include('layouts/main', { body: `
  <div class="error-page">
    <h1>Error ${typeof status !== 'undefined' ? status : ''}</h1>
    <p class="error-message">${typeof message !== 'undefined' ? message : 'An error occurred'}</p>
    ${typeof stack !== 'undefined' && stack ? '<pre class="error-stack">' + stack + '</pre>' : ''}
    <p><a href="/">Return to Home</a></p>
  </div>
`, title: 'Error', config: typeof config !== 'undefined' ? config : {}, bodyClass: 'error-page' }) %>
