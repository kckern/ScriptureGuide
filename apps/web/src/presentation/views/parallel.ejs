<%
// Markup follows parallel.php in the PHP site. Verse text is printed raw, as there.
const media = 'https://media.scripture.guide/covers';
const lv = lver.toLowerCase(), rv = rver.toLowerCase();
const fullChapter = !ischapter;
const trs = rows.map(r => `
		<tr class="">
			<td class='left ref'>
				<a class="ref" href="/${lv}/${r.left.slug}">${r.left.ref}</a>
				${r.left.fax ? `<a class="fax" id="left_${r.id}" target="_blank" href="https://img.scripture.guide/=/${lver}/${r.left.slug}">
					<img src="/img/book_open.png" />
				</a>` : ''}
			</td>
			<td></td>
			<td class='right ref'>
				${r.right.fax ? `<a class="fax" id="right_${r.id}" target="_blank" href="https://img.scripture.guide/=/${rver}/${r.right.slug}">
					<img src="/img/book_open.png" />
				</a>` : ''}
				<a class="ref" href="/${rv}/${r.right.slug}">${r.right.ref}</a>
			</td>
		</tr>
		<tr  id="row${r.id}" class="${r.className}">
			<td class='left text original'><div class='verse' verse_id='${r.left.verseId}' ref='${r.left.ref}' version='${lver}'>${r.left.text}</div></td>

			<td class='diff'></td>
			<td class='right text changed'><div class='verse' verse_id='${r.right.verseId}' ref='${r.right.ref}' version='${rver}'>${r.right.text}</div></td>

		</tr>
	`).join('');
%>
<%- include('layouts/main', {
  title,
  config,
  slugver: '',
  slugref: '',
  ogMeta: {
    title: title + ' | Scripture Guide',
    image: 'http://cover.scripture.guide/logo.png',
    description: '',
    url: ogUrl || ''
  },
  body: `
		<div id='container'>
<table class='parallel' id="table_1">

		<tr class='header'>
			<td>
				<img class="cover" edition="" src="${media}/${limg}.jpg"><br>
				<a style='word-break: break-all;' href="/${lv}/${leftheaderSlug}">${htmlLeftheader}</a>
			</td>
			<td align="center">
				<button class='compare' incr="1">&#128269;<br><small>DIFF</small></button>
				</td>
			<td>
				<img class="cover" edition="" src="${media}/${rimg}.jpg"><br>
				<a style='word-break: break-all;' href="/${rv}/${rightheaderSlug}">${htmlRightheader}</a>
			</td>
		</tr>
		<tr class="plinks">
			<td colspan=3 align="center">
				<a href="/${swapslug}">Switch ⇆ Sides</a>
				${fullChapter ? `<br><a href="/${chslug}">Full ⇅ Chapter</a>` : ''}
			</td>
		</tr>${trs}${fullChapter ? `
		<tr class="plinks">
			<td colspan=3 align="center" style="padding-top:2em;">
				<a href="/${chslug}">Full ⇅ Chapter</a>
			</td>
		</tr>` : ''}
</table>
<div id="floater"></div>

<script>
var fullslug = '${fullslug}';
var chslug = '${chslug}';
var swapslug = '${swapslug}';
	activateParallel();
</script>
		</div>
`
}) %>
