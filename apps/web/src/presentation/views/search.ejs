<%
// Markup follows search.php in the PHP site. Verse text is printed raw, as there.
// The query is escaped (PHP printed it raw): a deliberate fix, identical for plain words.
const coverHost = 'https://media.scripture.guide/covers';
const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const jsq = s => JSON.stringify(String(s)).replace(/</g, '\\u003c');
const shown = count >= 100 ? 'Selected' : count;
const tabs = vols.map(v => `
			<li onclick="volfilter('${v.key}')"><span>${v.count}</span>${v.label}</li>`).join('');
const trs = rows.map(r => `			<tr vol="${r.vol}" >
				<td style="white-space:nowrap; " valign='top' align="center">
					<div class="refblock"><a href="${r.href}" target="_blank">${r.refShort}
					<br/><img src="${coverHost}/${r.cover}.jpg"></a></div>
				</td>
				<td  class="searchtext">
					<span class="clipboard">${r.text}</span>
					<span class='verse v_${r.verse_id}' verse_id="${r.verse_id}" ref="${r.ref}" version="${r.version}">${r.highlighted}</span>
					<div><img 	onClick="copyToClipbord(this)"	src="/img/copy.svg"></div>
				</td>
			</tr>
`).join('');
%>
<%- include('layouts/main', {
  title: count ? count + ' Search Results' : 'Home',
  config,
  slugver: '',
  slugref: slugref || '',
  ogMeta: {
    title: (count ? count + ' Search Results' : 'Home') + ' | Scripture Guide',
    image: 'http://cover.scripture.guide/search',
    description: count + ' passages matching: ' + query,
    url: ogUrl || ''
  },
  body: `
		<div id='container'>
<script>
searchterm = ${jsq(query)};
versions_index = null


function copyToClipbord(e)
{
	e.src = "/img/check.svg";
	let main = e.parentElement.previousElementSibling;
	let clipboardtext = e.parentElement.previousElementSibling.previousElementSibling.textContent;
	let version = main.attributes.version.value;
	let ref = main.attributes.ref.value;
	let parenth = \` (\${ref}, \${version})\`;
	if(["LDS","KJV"].includes(version)) parenth = \` (\${ref})\`;
	parenth = parenth.replace("Doctrine and Covenants","D&C");
	let copyMe = clipboardtext + parenth;

	navigator.clipboard.writeText(copyMe);
}

</script>

		<h1 style='margin-top:30px; text-align:center; font-size:2em'>${shown} Search Results<br><small style='font-size:.7em; color:#777;'><em>“${esc(query)}”</em></small></h1>

		<ul class="tabs">${tabs}
		</ul>
		<table id="searchresults">${trs}
		</table>
		</div>
`
}) %>
