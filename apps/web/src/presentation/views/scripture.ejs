<%
const version = data.version || 'KJV';
const showNums = config.includeVerseNumbers !== false;
const ch = data.chapterHeading;
const nav = data.chapterNav;

// Helper: build a full <h3 class="heading"> with all production attrs
function buildH3(h, version) {
  const headless = (h.headless || !h.text) ? ' headless="1"' : '';
  const slug = h.slug ? ` slug="${h.slug}"` : '';
  const ref = h.ref ? ` ref="${h.ref}"` : '';
  const dispVc = h._displayVerseCount ?? h.verse_count;
  const dispLast = h._displayLast ?? h.last;
  const vc = (dispVc != null && dispVc > 0) ? ` verse_count="${dispVc}"` : '';
  const lv = dispLast ? ` last_verse_id="${dispLast}"` : '';
  const img = h.img ? ` img="${h.img}"` : '';
  const ver = h.ver ? ` tver="${h.tver || h.ver}" ver="${h.ver}"` : '';
  const audioAttr = h.audio > 0 ? ` audio="1"` : '';
  const parallelAttr = h.parallel ? ` parallel="${h.parallel}"` : '';
  const faxAttr = h.fax ? ` fax="1"` : '';
  // A heading without text shows its reference (PHP "Reference Headings")
  const text = (h.headless || !h.text) ? (h.ref || h.text || '') : h.text;
  let html = `<h3 class="heading" version="${version}" heading_verse_id="${h.displayVerseId || h.verse_id}"${vc}${lv}${headless}${ref}${slug}${ver}${img}${parallelAttr}${faxAttr}${audioAttr}>${text}</h3>`;
  return html;
}

// Build passage HTML — group verses into paragraphs based on paraBreak flag
// Mirrors PHP: multiple verse spans share one <p> unless separated by a ¶ marker
let passageHtml = '';
const lastVerseId = data.verses.length ? data.verses[data.verses.length - 1].id : null;

// Attach summary/headnote from chapterHeading to the chapter heading h3
const chapterH3Data = ch && data.h3ByVerse[ch.verse_id] ? data.h3ByVerse[ch.verse_id] : null;
if (chapterH3Data && ch) {
  chapterH3Data.audio = data.audio || 0;
}

// Collect paragraph groups: each group is { fmt, spans[], h3, inlineItems[] }
const paraGroups = [];
let currentGroup = null;

data.verses.forEach(verse => {
  // h3 attaches to the segment that triggers the new section (isSection), not segment 0
  // For multi-segment verses (§¶ mid-text), h3 attaches only at the isSection segment (not segIndex===0)
  const h3 = (verse.isSection || (verse.segIndex === 0 && verse.segCount === 1 && verse.lbIndex === 0)) && data.h3ByVerse[verse.id]
    ? data.h3ByVerse[verse.id]
    : null;
  // inlineItems only attach to first segment of each verse
  const inlineItems = (verse.segIndex === 0) ? (data.inlineByVerse[verse.id] || []) : [];
  const hasBreak = h3 || verse.paraBreak || !currentGroup || (inlineItems.length > 0);
  const fmt = verse.format || 'prose';
  const fmtChange = currentGroup && fmt !== currentGroup.fmt;

  if (hasBreak || fmtChange) {
    currentGroup = { fmt, spans: [], h3, inlineItems, ids: [] };
    paraGroups.push(currentGroup);
  }

  const ref = `${data.book || ''} ${data.chapter || ''}:${verse.num}`.trim();
  const bookSlug = (data.book || '').toLowerCase().replace(/\s+/g, '-');
  const verseClass = `${bookSlug}-${data.chapter}-${verse.num}`;
  // verse_label only on first segment and first linebreak part; second+ get no attr
  // Note: <sup class="vnum"> is NOT rendered server-side — JS adds it from verse_label attr
  const verseLabel = (verse.segIndex === 0 && verse.lbIndex === 0) ? (verse.num === 1 ? `${data.chapter}:${verse.num}` : verse.num) : null;
  const verseLabelAttr = verseLabel !== null ? ` verse_label="${verseLabel}"` : '';
  const lbClassStr = verse.lbClass ? ` ${verse.lbClass}` : '';
  const span = `<span class="verse v_${verse.id} ${fmt}${lbClassStr} ${verseClass}" verse_id="${verse.id}" ref="${ref}" version="${version}"${verseLabelAttr}>${verse.text}</span>`;
  currentGroup.spans.push(span);
  currentGroup.ids.push(verse.id);
});

// Each heading starts a new passage (<div class="passage ver_X">), as in the PHP renderer.
// Header rows around the h3 follow scriptutil::buildHeading; the "extras" (titles, headnote,
// background, summary) appear only when the passage has more than one verse and starts a section.
const showExtras = data.verseCount > 1 && data.startsSection;
const faxIds = new Set(data.faxIds || []);
const types = id => (data.typesByVerse && data.typesByVerse[id]) || {};

function headerRows(t, h3html) {
  let out = '';
  if (showExtras) {
    if (t.title) {
      let c = t.pretitle ? `<small>${t.pretitle}</small><br>` : '';
      c += t.title;
      if (t.timeframe) c += `<br/><small class='timeframe'>${t.timeframe}</small>`;
      if (t.subtitle) c += `<br/><small>${t.subtitle}</small>`;
      out += `\n\t\t<h2 version="${version}">${c}</h2>`;
    }
    if (t.part_title) out += `\n\t\t<h1 version="${version}">${t.part_title}${t.part_subtitle ? `<br/><small>${t.part_subtitle}</small>` : ''}</h1>`;
    if (t.book_title) {
      let c = t.book_title;
      if (t.timeframe) c += `<br/><small class='timeframe'>${t.timeframe}</small>`;
      if (t.book_subtitle) c += `<br/><small>${t.book_subtitle}</small>`;
      out += `\n\t\t<h2 version="${version}">${c}</h2>`;
    }
    if (t.section_title) out += `\n\t\t<h3 version="${version}" class="section_title">${t.section_title}${t.section_subtitle ? `<br/><small>${t.section_subtitle}</small>` : ''}</h3>`;
    if (t.headnote) {
      if (t.headnote_heading) out += `\n\t\t<h3 version="${version}" class="headnote_heading">${t.headnote_heading}</h3>`;
      out += `\n\t\t<div class="headnote" version="${version}">${t.headnote}${t.headnotecomment ? ` <div class='comment'>${t.headnotecomment}</div>` : ''}</div>`;
    }
  }
  out += `\n\t\t${h3html}`;
  if (showExtras) {
    if (t.headnote_sub) out += `\n\t\t<div class="headnote" version="${version}">${t.headnote_sub}</div>`;
    if (t.background) out += `\n\t\t<div class="background" version="${version}">${t.background}</div>`;
    if (t.summary) out += `\n\t\t<div class="summary" version="${version}">${t.summary}</div>`;
  }
  if (t.section_footer) out += `\n\t\t<div class="footer" version="${version}" footer="1">${t.section_footer}</div>`;
  return out;
}

const passages = [];
let current = null;
function startPassage(h3, t, ellipsis) {
  current = { h3, t, ellipsis, body: '', ids: [] };
  passages.push(current);
}

// Pre-passage heading: the passage starts inside a section that began earlier;
// its heading is followed by an ellipsis paragraph for the omitted verses.
if (data.prePassageH3) {
  const pph = data.prePassageH3;
  startPassage(pph, ch || {}, `\n\t\t<p class="ellipses" heading_verse_id="${pph.verse_id}" verse_count="${pph.ellipsisVerseCount}" last_verse_id="${pph.ellipsisLast}">...</p>`);
}

const headerTypes = new Set(['headnote', 'summary', 'background', 'headnote_sub']);
paraGroups.forEach(group => {
  if (group.h3 || !current) {
    const id = group.h3 ? group.h3.verse_id : null;
    const t = group.h3 ? (id === ch?.verse_id ? { ...types(id), ...ch } : types(id)) : {};
    startPassage(group.h3, t, '');
  }

  group.inlineItems.forEach(h => {
    if (h.type === 'verse_head' && h.text) {
      current.body += `\n\t\t<div class="verse_head">${h.text}</div>`;
    } else if (!group.h3 && headerTypes.has(h.type) && h.text) {
      current.body += `\n\t\t<div class="${h.type}" version="${version}">${h.text}</div>`;
    }
  });

  const content = group.spans.join(' ');
  if (group.fmt === 'poetry') {
    current.body += `\n\t\t<blockquote class="poetry">${content}</blockquote>`;
  } else if (group.fmt === 'indent') {
    current.body += `\n\t\t<blockquote class="indent">${content}</blockquote>`;
  } else {
    current.body += `\n\t\t<p class="${group.fmt}">${content}</p>`;
  }
  current.ids.push(...group.ids);
});

let passagesHtml = '';
for (const p of passages) {
  let header = '';
  if (p.h3) {
    const ids = [...new Set(p.ids)];
    const fax = ids.length > 0 && ids.every(id => faxIds.has(id));
    header = headerRows(p.t, buildH3({ ...p.h3, fax }, version)) + p.ellipsis;
  }
  passagesHtml += `\n      <div class="passage ver_${p.h3 ? version : ''}">${header}${p.body}\n      </div>`;
}

// Chapter nav: its own passage after the text (no version on its first element)
if (nav) {
  let links = '';
  if (nav.prev) links += `<a href="${nav.prev.href}" class="prev">◀ ${nav.prev.label}</a>`;
  if (nav.next) links += `<a href="${nav.next.href}" class="next">${nav.next.label} ▶</a>`;
  passagesHtml += `\n      <div class="passage ver_">\n\t\t<div class="chapterNav">${links}</div>\n      </div>`;
}
%>
<%- include('layouts/main', {
  title: data.title,
  config,
  slugref: data.canonicalRefSlug || '',
  slugver: version,
  body: `
<div id="container">
  <div class="scriptures">
    <div class="section">
${passagesHtml}
    </div>
  </div>
</div>
<div class="containerCopy">
  <div onclick="copyContainerToClipbord(this)"><img src="/img/copy.svg">Copy</div>
</div>
`
}) %>
