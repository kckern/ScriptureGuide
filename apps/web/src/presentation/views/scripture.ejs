<%
const version = data.version || 'KJV';

// Renders one reference block (a "section"): its passages and chapter nav.
const renderSection = d => include('partials/section', { data: d });

// Several references separated by ";" render as sections divided by an hr.
const sectionList = (typeof sections !== 'undefined' && sections) ? sections : [data];
const sectionsHtml = sectionList
  .map(d => `\n    <div class="section">${renderSection(d)}\n    </div>`)
  .join(`\n    <hr class="sectionbreak"/>`);
%>
<%- include('layouts/main', {
  title: typeof title !== 'undefined' ? title : data.title,
  config,
  slugref: data.canonicalRefSlug || '',
  slugver: version,
  body: `
<div id="container">
  <div class="scriptures">
${sectionsHtml}
  </div>
</div>
<div class="containerCopy">
  <div onclick="copyContainerToClipbord(this)"><img src="/img/copy.svg">Copy</div>
</div>
`
}) %>
