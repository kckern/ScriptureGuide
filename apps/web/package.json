{
  "name": "@scripture-guide/web",
  "private": true,
  "version": "2.0.1",
  "description": "Scripture reference lookup and display - Node.js SSR",
  "type": "module",
  "main": "src/app.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --watch",
    "lint": "eslint src/",
    "parity": "node test/parity/run.mjs",
    "browser": "node test/browser/smoke.mjs"
  },
  "keywords": [
    "bible",
    "scripture",
    "lds",
    "book-of-mormon",
    "reference",
    "ssr"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.2",
    "helmet": "^7.1.0",
    "mysql2": "^3.24.6",
    "scripture-guide": "^1.1.0"
  },
  "devDependencies": {
    "cheerio": "^1.1.0",
    "eslint": "^8.56.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "supertest": "^6.3.3",
    "vitest": "^4.1.12"
  }
