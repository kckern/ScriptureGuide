    "express-session": "^1.17.3",
    "fluent-ffmpeg": "^2.1.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.5",
    "scripture-guide": "^1.0.85"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
